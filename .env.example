# Copy to .env for local development. Keep this file uncommitted.
VIDBOOK_ENVIRONMENT=development
VIDBOOK_DB_PATH=data/vidbook.db
VIDBOOK_STORAGE_PATH=data/projects
# Set this before exposing the API beyond localhost.
# VIDBOOK_API_TOKEN=replace-with-a-long-random-token
VIDBOOK_CORS_ORIGINS=http://localhost:5173
